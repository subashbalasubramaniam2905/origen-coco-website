{% macro icon(name, cls="ico", sw="1.6") -%}
<svg class="{{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ sw }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">{{ ICONS[name] | safe }}</svg>
{%- endmacro %}

{# A two-column table. Empty values print as "To be confirmed" so a missing
   spec is visible instead of silently invented. #}
{% macro data_table(rows, key, val, head_key, head_val, tbc, cls="tbl") -%}
<table class="{{ cls }}">
  <thead><tr><th>{{ head_key }}</th><th>{{ head_val }}</th></tr></thead>
  <tbody>
  {% for r in rows %}
    <tr><td>{{ r[key] }}</td>{% if r[val] %}<td>{{ r[val] }}</td>{% else %}<td class="tbc">{{ tbc }}</td>{% endif %}</tr>
  {% endfor %}
  </tbody>
</table>
{%- endmacro %}

{% macro variants_table(p, L, cls="tbl") -%}
{{ data_table(p.variants, "item", "details", L.item, L.details, L.tbc, cls) }}
{%- endmacro %}

{% macro specs_table(p, L, cls="tbl") -%}
{{ data_table(p.specs, "parameter", "value", L.parameter, L.value, L.tbc, cls) }}
{%- endmacro %}

{% macro contact_list(ct, cls="reach") -%}
<ul class="{{ cls }}">
  <li>{{ icon("pin") }}<span><small>{{ ct.address_label }}</small>{{ ct.address }}</span></li>
  <li>{{ icon("phone") }}<span><small>{{ ct.phone_label }}</small>{{ ct.phone }}</span></li>
  <li>{{ icon("mail") }}<span><small>{{ ct.email_label }}</small>{{ ct.email }}</span></li>
  {% if ct.website %}<li>{{ icon("globe") }}<span><small>Website</small>{{ ct.website }}</span></li>{% endif %}
</ul>
{%- endmacro %}

{% macro head(c, title, own, shared, tpl) -%}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ c.company.name }} | {{ title }}</title>
<link rel="stylesheet" href="{{ own }}fonts/fonts.css">
<link rel="stylesheet" href="{{ shared }}base.css">
<link rel="stylesheet" href="{{ tpl }}style.css">
</head>
{%- endmacro %}
